---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const blogPosts = [
	{
		title: "Telco Cloud Transformation: Modernizing OSS/BSS for the 5G Era",
		excerpt: "Telecom operators are re-platforming OSS/BSS stacks to keep pace with 5G.",
		date: "August 11, 2026",
		author: "MapKloud Team",
		slug: "telco-cloud-transformation-5g",
		categories: ["Telecom", "Cloud"],
		readTime: "8 min read"
	},
	{
		title: "Securing Hybrid Cloud Environments: A Zero-Trust Blueprint",
		excerpt: "As workloads span on-prem and cloud, perimeter security no longer works.",
		date: "April 27, 2026",
		author: "MapKloud Team",
		slug: "hybrid-cloud-security-zero-trust",
		categories: ["Security", "Hybrid Cloud"],
		readTime: "9 min read"
	},
	{
		title: "Why Enterprises Are Standardizing on Red Hat OpenShift",
		excerpt: "OpenShift is becoming the default enterprise Kubernetes platform — here's why.",
		date: "February 3, 2026",
		author: "MapKloud Team",
		slug: "openshift-enterprise-kubernetes-platform",
		categories: ["OpenShift", "Kubernetes"],
		readTime: "7 min read"
	},
	{
		title: "The Future of Cloud Migration: Trends to Watch in 2025",
		excerpt: "Multi-cloud strategy and edge computing are reshaping migration playbooks.",
		date: "December 15, 2024",
		author: "MapKloud Team",
		slug: "cloud-migration-trends-2025",
		categories: ["Cloud", "Migration"],
		readTime: "5 min read"
	},
	{
		title: "AI-Powered Automation: Transforming Business Processes",
		excerpt: "How intelligent document processing is transforming business operations.",
		date: "December 10, 2024",
		author: "MapKloud Team",
		slug: "ai-automation-business-processes",
		categories: ["AI", "Automation"],
		readTime: "7 min read"
	},
	{
		title: "Data-Driven Decision Making: A Strategic Guide",
		excerpt: "Turning analytics into informed, confident strategic choices.",
		date: "December 5, 2024",
		author: "MapKloud Team",
		slug: "data-driven-decision-making-guide",
		categories: ["Analytics", "Strategy"],
		readTime: "6 min read"
	},
	{
		title: "Multi-Cloud Strategy: Best Practices for Enterprise",
		excerpt: "Proven strategies for cost optimization, security, and performance.",
		date: "November 28, 2024",
		author: "MapKloud Team",
		slug: "multi-cloud-strategy-best-practices",
		categories: ["Cloud", "Enterprise"],
		readTime: "8 min read"
	},
	{
		title: "RPA Implementation: From Planning to Production",
		excerpt: "A practical guide to planning, developing, and deploying RPA.",
		date: "November 20, 2024",
		author: "MapKloud Team",
		slug: "rpa-implementation-guide",
		categories: ["RPA", "Automation"],
		readTime: "10 min read"
	},
	{
		title: "Cybersecurity in the Cloud: Essential Protection Strategies",
		excerpt: "Identity management, data protection, and compliance frameworks.",
		date: "November 15, 2024",
		author: "MapKloud Team",
		slug: "cloud-cybersecurity-strategies",
		categories: ["Security", "Cloud"],
		readTime: "9 min read"
	}
];
---

<Layout title="Blog - MapKloud Insights" description="Stay updated with the latest trends in digital transformation, cloud technologies, and AI solutions from MapKloud experts.">
	<Navbar />

	<!-- Page Header -->
	<section class="pt-32 pb-16 bg-navy-deep">
		<div class="container mx-auto px-6 lg:px-8 text-center">
			<div class="mb-4">
				<a href="/" class="inline-flex items-center text-sm text-white/60 hover:text-white transition-colors duration-200">
					&larr; Back to Home
				</a>
			</div>
			<span class="section-label text-cloud-blue block">Insights</span>
			<h1 class="font-serif font-bold text-white text-4xl sm:text-5xl mt-4 mb-4">
				Latest Insights
			</h1>
			<p class="italic text-white/60 text-base sm:text-lg max-w-2xl mx-auto">
				Ideas on cloud, AI, and data — from our team
			</p>
		</div>
	</section>

	<!-- Blog Posts -->
	<section class="py-20 sm:py-24 bg-white">
		<div class="container mx-auto px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{blogPosts.map((post) => (
					<article class="bg-white rounded-lg border-t-4 border-cloud-blue border border-ice-blue-border p-6">
						<div class="flex items-center justify-between text-xs text-text-muted mb-3">
							<span>{post.date}</span>
							<span>{post.readTime}</span>
						</div>
						<h3 class="font-bold text-navy-deep text-lg mb-2">
							{post.title}
						</h3>
						<p class="text-text-gray text-sm mb-4">
							{post.excerpt}
						</p>
						<div class="flex items-center justify-between">
							<div class="flex items-center space-x-2">
								{post.categories.map((category) => (
									<span class="text-xs font-semibold uppercase tracking-wide text-cloud-blue">
										{category}
									</span>
								))}
							</div>
							<a href={`/blog/${post.slug}`} class="text-cloud-blue hover:text-navy font-medium text-sm transition-colors duration-200">
								Read more &rarr;
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<Footer />
</Layout>
