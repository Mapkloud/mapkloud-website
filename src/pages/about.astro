---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MissionBand from '../components/MissionBand.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About MapKloud - Consulting. Engineering. Delivery." description="MapKloud helps enterprises accelerate digital transformation through cloud technologies, platform engineering, intelligent automation, artificial intelligence, and modern software delivery.">
	<Navbar />

	<!-- Page Header -->
	<section class="pt-32 pb-16 bg-navy-deep">
		<div class="container mx-auto px-6 lg:px-8 text-center">
			<div class="mb-4">
				<a href="/" class="inline-flex items-center text-sm text-white/60 hover:text-white transition-colors duration-200">
					&larr; Back to Home
				</a>
			</div>
			<span class="section-label text-cloud-blue block">About Us</span>
			<h1 class="font-serif font-bold text-white text-4xl sm:text-5xl mt-4 mb-4">
				About MapKloud
			</h1>
			<p class="italic text-white/60 text-base sm:text-lg max-w-2xl mx-auto">
				Your trusted partner for innovative digital transformation solutions
			</p>
		</div>
	</section>

	<!-- Who We Are -->
	<section class="py-20 sm:py-24 bg-white">
		<div class="container mx-auto px-6 lg:px-8">
			<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div>
					<span class="section-label text-navy">Who We Are</span>
					<span class="section-label-bar"></span>
					<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-5 mb-6">
						The Partner of Choice for Leading Enterprises
					</h2>
					<p class="text-text-gray mb-4">
						MapKloud helps enterprises accelerate digital transformation through cloud technologies, platform engineering, intelligent automation, artificial intelligence, and modern software delivery.
					</p>
					<p class="text-text-gray">
						We combine strategic consulting with hands-on engineering and delivery expertise to build scalable, secure, production-ready digital platforms that generate measurable business outcomes.
					</p>
				</div>
				<div class="bg-ice-blue-bg border border-ice-blue-border rounded-lg p-8">
					<div class="grid grid-cols-2 gap-8">
						<div class="text-center">
							<div class="font-serif text-3xl font-bold text-navy-deep mb-1">50+</div>
							<div class="text-sm text-text-muted">Projects Delivered</div>
						</div>
						<div class="text-center">
							<div class="font-serif text-3xl font-bold text-navy-deep mb-1">10+</div>
							<div class="text-sm text-text-muted">Happy Clients</div>
						</div>
						<div class="text-center">
							<div class="font-serif text-3xl font-bold text-navy-deep mb-1">15+</div>
							<div class="text-sm text-text-muted">Years Experience</div>
						</div>
						<div class="text-center">
							<div class="font-serif text-3xl font-bold text-navy-deep mb-1">100%</div>
							<div class="text-sm text-text-muted">Client Satisfaction</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Services -->
	<section class="py-20 sm:py-24 bg-ice-blue-bg">
		<div class="container mx-auto px-6 lg:px-8">
			<div class="text-center mb-16">
				<span class="section-label text-navy">Service Portfolio</span>
				<span class="section-label-bar mx-auto"></span>
				<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-5">
					Our Core Services
				</h2>
			</div>
			<div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-8">
				<!-- Cloud Migration & Modernization -->
				<div class="flex items-center gap-4">
					<div class="flex-shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center">
						<svg class="w-6 h-6 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-navy-deep text-sm">Cloud Migration &amp; Modernization</h3>
				</div>

				<!-- Infrastructure Engineering -->
				<div class="flex items-center gap-4">
					<div class="flex-shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center">
						<svg class="w-6 h-6 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7c0-2.21-3.582-4-8-4S4 4.79 4 7z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4"></path>
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 12c0 2.21 3.582 4 8 4s8-1.79 8-4"></path>
						</svg>
					</div>
					<h3 class="font-bold text-navy-deep text-sm">Infrastructure Engineering</h3>
				</div>

				<!-- Platform Engineering -->
				<div class="flex items-center gap-4">
					<div class="flex-shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center">
						<svg class="w-6 h-6 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-navy-deep text-sm">Platform Engineering</h3>
				</div>

				<!-- DevOps & Automation -->
				<div class="flex items-center gap-4">
					<div class="flex-shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center">
						<svg class="w-6 h-6 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-navy-deep text-sm">DevOps &amp; Automation</h3>
				</div>

				<!-- IoT Platform Development -->
				<div class="flex items-center gap-4">
					<div class="flex-shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center">
						<svg class="w-6 h-6 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M15.75 3v1.5M8.25 19.5V21M15.75 19.5V21M3 8.25h1.5M3 15.75h1.5M19.5 8.25H21M19.5 15.75H21M5.25 5.25h13.5v13.5H5.25V5.25zM9 9h6v6H9V9z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-navy-deep text-sm">IoT Platform Development</h3>
				</div>

				<!-- Artificial Intelligence Solutions -->
				<div class="flex items-center gap-4">
					<div class="flex-shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center">
						<svg class="w-6 h-6 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-navy-deep text-sm">Artificial Intelligence Solutions</h3>
				</div>

				<!-- Cloud-Native Architecture & Kubernetes Platforms -->
				<div class="flex items-center gap-4">
					<div class="flex-shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center">
						<svg class="w-6 h-6 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"></path>
						</svg>
					</div>
					<h3 class="font-bold text-navy-deep text-sm">Cloud-Native Architecture &amp; Kubernetes Platforms</h3>
				</div>
			</div>
		</div>
	</section>

	<!-- Mission band -->
	<MissionBand quote="With over 15 years of experience, we've built trusted partnerships across industries and continents." />

	<!-- Our Approach -->
	<section class="py-20 sm:py-24 bg-white">
		<div class="container mx-auto px-6 lg:px-8">
			<div class="text-center mb-16">
				<span class="section-label text-navy">How We Work</span>
				<span class="section-label-bar mx-auto"></span>
				<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-5">
					Our Approach
				</h2>
			</div>
			<div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8">
				<div class="text-center">
					<div class="w-12 h-12 rounded-full bg-cloud-blue text-white font-serif font-bold flex items-center justify-center mx-auto mb-4">1</div>
					<h3 class="font-bold text-navy-deep mb-1">Understand</h3>
					<p class="text-text-gray text-sm">We start with your business challenges and goals.</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 rounded-full bg-cloud-blue text-white font-serif font-bold flex items-center justify-center mx-auto mb-4">2</div>
					<h3 class="font-bold text-navy-deep mb-1">Innovate</h3>
					<p class="text-text-gray text-sm">We apply the right technology to deliver results.</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 rounded-full bg-cloud-blue text-white font-serif font-bold flex items-center justify-center mx-auto mb-4">3</div>
					<h3 class="font-bold text-navy-deep mb-1">Deliver</h3>
					<p class="text-text-gray text-sm">We ship on time and measure business impact.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="py-20 sm:py-24 bg-ice-blue-bg">
		<div class="container mx-auto px-6 lg:px-8">
			<div class="text-center mb-16">
				<span class="section-label text-navy">Why MapKloud</span>
				<span class="section-label-bar mx-auto"></span>
				<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-5">
					Why Choose MapKloud?
				</h2>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="bg-white rounded-lg border-t-4 border-cloud-blue p-6">
					<h3 class="font-bold text-navy-deep mb-1">Expert Team</h3>
					<p class="text-text-gray text-sm">Certified professionals with proven track records.</p>
				</div>
				<div class="bg-white rounded-lg border-t-4 border-cloud-blue p-6">
					<h3 class="font-bold text-navy-deep mb-1">Quality Focus</h3>
					<p class="text-text-gray text-sm">Rigorous testing and quality assurance.</p>
				</div>
				<div class="bg-white rounded-lg border-t-4 border-cloud-blue p-6">
					<h3 class="font-bold text-navy-deep mb-1">Innovation</h3>
					<p class="text-text-gray text-sm">Cutting-edge technologies and methodologies.</p>
				</div>
				<div class="bg-white rounded-lg border-t-4 border-cloud-blue p-6">
					<h3 class="font-bold text-navy-deep mb-1">Partnership</h3>
					<p class="text-text-gray text-sm">Long-term relationships built on trust.</p>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
