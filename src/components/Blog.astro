---
// Latest Insights — concise cards with a thin cloud-blue top accent bar
---

<section id="blog" class="py-20 sm:py-24 bg-white">
	<div class="container mx-auto px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center mb-16">
			<span class="section-label text-navy">Insights</span>
			<span class="section-label-bar mx-auto"></span>
			<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-5 mb-4">
				Latest Perspectives
			</h2>
			<p class="italic text-text-muted text-sm sm:text-base max-w-2xl mx-auto">
				Ideas on cloud, AI, and data — from our team
			</p>
		</div>

		<!-- Posts Grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<!-- Post 1 -->
			<article class="bg-white rounded-lg border-t-4 border-cloud-blue border border-ice-blue-border p-6">
				<span class="text-xs font-semibold uppercase tracking-wide text-cloud-blue">Cloud &middot; Migration</span>
				<h3 class="font-bold text-navy-deep text-lg mt-2 mb-2">
					Cloud Migration Trends to Watch in 2025
				</h3>
				<p class="text-text-gray text-sm mb-4">Multi-cloud strategy and edge computing are reshaping migration playbooks.</p>
				<a href="/blog/cloud-migration-trends-2025" class="text-cloud-blue hover:text-navy font-medium text-sm transition-colors duration-200">
					Read more &rarr;
				</a>
			</article>

			<!-- Post 2 -->
			<article class="bg-white rounded-lg border-t-4 border-cloud-blue border border-ice-blue-border p-6">
				<span class="text-xs font-semibold uppercase tracking-wide text-cloud-blue">AI &middot; Automation</span>
				<h3 class="font-bold text-navy-deep text-lg mt-2 mb-2">
					AI-Powered Automation, Applied
				</h3>
				<p class="text-text-gray text-sm mb-4">How intelligent document processing is transforming business operations.</p>
				<a href="/blog/ai-automation-business-processes" class="text-cloud-blue hover:text-navy font-medium text-sm transition-colors duration-200">
					Read more &rarr;
				</a>
			</article>

			<!-- Post 3 -->
			<article class="bg-white rounded-lg border-t-4 border-cloud-blue border border-ice-blue-border p-6">
				<span class="text-xs font-semibold uppercase tracking-wide text-cloud-blue">Analytics &middot; Strategy</span>
				<h3 class="font-bold text-navy-deep text-lg mt-2 mb-2">
					A Strategic Guide to Data-Driven Decisions
				</h3>
				<p class="text-text-gray text-sm mb-4">Turning analytics into informed, confident strategic choices.</p>
				<a href="/blog/data-driven-decision-making-guide" class="text-cloud-blue hover:text-navy font-medium text-sm transition-colors duration-200">
					Read more &rarr;
				</a>
			</article>
		</div>

		<!-- View All -->
		<div class="text-center mt-12">
			<a href="/blog" class="text-cloud-blue hover:text-navy font-semibold text-sm transition-colors duration-200">
				View All Posts &rarr;
			</a>
		</div>
	</div>
</section>
