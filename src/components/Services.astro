---
// Service Portfolio & Industry Expertise — two-column layout: services (ice-blue panel) vs. industries (white)
---

<section id="services" class="py-20 sm:py-24 bg-white">
	<div class="container mx-auto px-6 lg:px-8">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
			<!-- Services column — ice-blue panel, tile grid -->
			<div class="bg-ice-blue-bg border border-ice-blue-border rounded-lg p-8 sm:p-10">
				<span class="section-label text-navy">Service Portfolio</span>
				<span class="section-label-bar"></span>

				<div class="mt-8 grid grid-cols-2 gap-3">
					<!-- Cloud Migration & Modernization -->
					<div class="bg-white rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
							</svg>
						</div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">Cloud Migration &amp; Modernization</h4>
						<p class="text-text-muted text-[11px] leading-snug">Move to the cloud, disruption-free</p>
					</div>

					<!-- Infrastructure Engineering -->
					<div class="bg-white rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7c0-2.21-3.582-4-8-4S4 4.79 4 7z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4"></path>
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 12c0 2.21 3.582 4 8 4s8-1.79 8-4"></path>
							</svg>
						</div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">Infrastructure Engineering</h4>
						<p class="text-text-muted text-[11px] leading-snug">Reliable systems that scale with you</p>
					</div>

					<!-- Platform Engineering -->
					<div class="bg-white rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"></path>
							</svg>
						</div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">Platform Engineering</h4>
						<p class="text-text-muted text-[11px] leading-snug">Faster development, fewer bottlenecks</p>
					</div>

					<!-- DevOps & Automation -->
					<div class="bg-white rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							</svg>
						</div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">DevOps &amp; Automation</h4>
						<p class="text-text-muted text-[11px] leading-snug">Ship updates faster and safer</p>
					</div>

					<!-- IoT Platform Development -->
					<div class="bg-white rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M15.75 3v1.5M8.25 19.5V21M15.75 19.5V21M3 8.25h1.5M3 15.75h1.5M19.5 8.25H21M19.5 15.75H21M5.25 5.25h13.5v13.5H5.25V5.25zM9 9h6v6H9V9z"></path>
							</svg>
						</div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">IoT Platform Development</h4>
						<p class="text-text-muted text-[11px] leading-snug">Connect devices to real-time data</p>
					</div>

					<!-- Artificial Intelligence Solutions -->
					<div class="bg-white rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
							</svg>
						</div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">Artificial Intelligence Solutions</h4>
						<p class="text-text-muted text-[11px] leading-snug">Smarter decisions, automated</p>
					</div>

					<!-- Cloud-Native Architecture & Kubernetes Platforms — spans full width -->
					<div class="col-span-2 bg-white rounded-lg p-4 flex items-center justify-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"></path>
							</svg>
						</div>
						<div class="text-left">
							<h4 class="font-bold text-navy-deep text-xs leading-snug">Cloud-Native Architecture &amp; Kubernetes Platforms</h4>
							<p class="text-text-muted text-[11px] leading-snug">Apps that scale automatically, anywhere</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Industries column — white -->
			<div id="industries" class="p-8 sm:p-10">
				<span class="section-label text-navy">Industry Expertise</span>
				<span class="section-label-bar"></span>

				<div class="mt-8 grid grid-cols-2 gap-3">
					<!-- Telecommunications -->
					<div class="bg-ice-blue-bg rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-white flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 111.06 0z"></path>
							</svg>
						</div>
						<div>
							<h4 class="font-bold text-navy-deep text-xs leading-snug">Telecommunications</h4>
							<p class="text-text-muted text-[11px] leading-snug mt-1">5G, OSS/BSS &amp; network platforms</p>
						</div>
					</div>

					<!-- Public Sector -->
					<div class="bg-ice-blue-bg rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-white flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
							</svg>
						</div>
						<div>
							<h4 class="font-bold text-navy-deep text-xs leading-snug">Public Sector</h4>
							<p class="text-text-muted text-[11px] leading-snug mt-1">Secure, modern government platforms</p>
						</div>
					</div>

					<!-- Energy & Utilities -->
					<div class="bg-ice-blue-bg rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-white flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
						</div>
						<div>
							<h4 class="font-bold text-navy-deep text-xs leading-snug">Energy &amp; Utilities</h4>
							<p class="text-text-muted text-[11px] leading-snug mt-1">Modern, automated utility infrastructure</p>
						</div>
					</div>

					<!-- Enterprise Platforms -->
					<div class="bg-ice-blue-bg rounded-lg p-4 flex flex-col items-center text-center gap-3">
						<div class="flex-shrink-0 w-11 h-11 rounded-full bg-white flex items-center justify-center">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3.75h15v16.5h-15V3.75zM9 21V9.75h6V21"></path>
							</svg>
						</div>
						<div>
							<h4 class="font-bold text-navy-deep text-xs leading-snug">Enterprise Platforms</h4>
							<p class="text-text-muted text-[11px] leading-snug mt-1">Cloud-native platforms &amp; automation</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
