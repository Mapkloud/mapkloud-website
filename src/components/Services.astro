---

<!-- Service Portfolio -->
<section id="services" class="py-20 sm:py-24 bg-ice-blue-bg">
	<div class="container mx-auto px-6 lg:px-8">
		<div class="text-center mb-16">
			<span class="section-label text-navy">Service Portfolio</span>
			<span class="section-label-bar mx-auto"></span>
			<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-5 max-w-2xl mx-auto">
				End-to-End Digital Transformation Services
			</h2>
		</div>

		<div class="flex flex-wrap justify-center gap-4">
			{services.map((service) => (
				<div class="bg-white rounded-lg p-5 flex flex-col items-center text-center gap-3 w-full sm:w-[calc(50%-0.5rem)] lg:w-[220px]">
					<div class="flex-shrink-0 w-11 h-11 rounded-full bg-ice-blue-bg flex items-center justify-center">
						<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							{service.path.split("|").map((d) => (
								<path stroke-linecap="round" stroke-linejoin="round" d={d}></path>
							))}
						</svg>
					</div>
					<div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">{service.title}</h4>
						<p class="text-text-muted text-[11px] leading-snug mt-1">{service.caption}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<!-- Industry Expertise -->
<section id="industries" class="py-20 sm:py-24 bg-white">
	<div class="container mx-auto px-6 lg:px-8">
		<div class="text-center mb-16">
			<span class="section-label text-navy">Industry Expertise</span>
			<span class="section-label-bar mx-auto"></span>
			<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-5 max-w-2xl mx-auto">
				Deep Experience Across Critical Industries
			</h2>
		</div>

		<div class="flex flex-wrap justify-center gap-4">
			{industries.map((industry) => (
				<div class="bg-ice-blue-bg rounded-lg p-5 flex flex-col items-center text-center gap-3 w-full sm:w-[calc(50%-0.5rem)] lg:w-[220px]">
					<div class="flex-shrink-0 w-11 h-11 rounded-full bg-white flex items-center justify-center">
						<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							{industry.path.split("|").map((d) => (
								<path stroke-linecap="round" stroke-linejoin="round" d={d}></path>
							))}
						</svg>
					</div>
					<div>
						<h4 class="font-bold text-navy-deep text-xs leading-snug">{industry.title}</h4>
						<p class="text-text-muted text-[11px] leading-snug mt-1">{industry.caption}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
