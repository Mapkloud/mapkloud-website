			<!-- CTA line -->
			<div class="flex flex-col sm:flex-row sm:items-center gap-4">
				<p class="font-serif text-xl text-white">Ready to start your transformation?</p>
				<a href="mailto:info@mapkloud.com" class="inline-flex items-center justify-center bg-cloud-blue hover:bg-cloud-blue/90 text-white px-5 py-2 rounded-md text-sm font-semibold transition-colors duration-200 w-fit">
