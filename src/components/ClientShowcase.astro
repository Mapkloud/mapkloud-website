---
// Trusted By — real client engagements, concise cards with a thin cloud-blue top accent bar.
// Each card uses an icon reflecting the nature of the project delivered.
const clients = [
	{
		name: "Turkish Red Crescent",
		project: "SAP Data Intelligence Cloud Transformation",
		// bar-chart / data icon
		path: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z",
	},
	{
		name: "TCCB — Presidency of the Republic of Türkiye",
		project: "National Library Management System Container Platform",
		// cube / container platform icon
		path: "M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9",
	},
	{
		name: "Qualcomm GmbH",
		project: "Configuration Management Cloud Migration",
		// cloud / migration icon
		path: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z",
	},
	{
		name: "DeltaG Technology",
		project: "Ericsson OSS/BSS Modernization",
		// signal / telecom icon
		path: "M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 111.06 0z",
	},
	{
		name: "SOCAR Energy",
		project: "StarThings IoT Platform Integration and Delivery",
		// chip / IoT icon
		path: "M8.25 3v1.5M15.75 3v1.5M8.25 19.5V21M15.75 19.5V21M3 8.25h1.5M3 15.75h1.5M19.5 8.25H21M19.5 15.75H21M5.25 5.25h13.5v13.5H5.25V5.25zM9 9h6v6H9V9z",
	},
	{
		name: "Stratis Digital",
		project: "Enterprise Hybrid Cloud Platform Delivery",
		// layered / hybrid infrastructure icon
		path: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7c0-2.21-3.582-4-8-4S4 4.79 4 7z|M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4|M4 12c0 2.21 3.582 4 8 4s8-1.79 8-4",
	},
];
---

<section class="py-20 sm:py-24 bg-ice-blue-bg">
	<div class="container mx-auto px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center mb-16">
			<span class="section-label text-navy">Trusted By</span>
			<span class="section-label-bar mx-auto"></span>
			<h2 class="font-serif font-bold text-navy-deep text-2xl sm:text-3xl mt-5 max-w-3xl mx-auto">
				Leading Public Sector, Energy, Telecommunications &amp; Enterprise Organizations
			</h2>
		</div>

		<div class="flex flex-wrap justify-center gap-4">
			{clients.map((client) => (
				<div class="bg-white rounded-lg border-t-4 border-cloud-blue border border-ice-blue-border p-5 w-full sm:w-[calc(50%-0.5rem)] lg:w-[220px]">
					<div class="flex items-center gap-3 mb-2">
						<div class="w-10 h-10 rounded-full bg-ice-blue-bg flex items-center justify-center flex-shrink-0">
							<svg class="w-5 h-5 text-cloud-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								{client.path.split("|").map((d) => (
									<path stroke-linecap="round" stroke-linejoin="round" d={d}></path>
								))}
							</svg>
						</div>
						<h3 class="font-bold text-navy-deep text-sm leading-snug">{client.name}</h3>
					</div>
					<p class="text-text-muted text-xs">{client.project}</p>
				</div>
			))}
		</div>
	</div>
</section>
