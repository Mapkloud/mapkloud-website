---
// Trusted By — real client engagements, concise cards with a thin cloud-blue top accent bar
const clients = [
	{ name: "Turkish Red Crescent", project: "SAP Data Intelligence Cloud Transformation", initials: "TRC" },
	{ name: "TCCB — Presidency of the Republic of Türkiye", project: "National Library Management System Container Platform", initials: "TCCB" },
	{ name: "Qualcomm GmbH", project: "Configuration Management Cloud Migration", initials: "Q" },
	{ name: "DeltaG Technology", project: "Ericsson OSS/BSS Modernization", initials: "DG" },
	{ name: "SOCAR Energy", project: "StarThings IoT Platform Integration and Delivery", initials: "SE" },
];
---

<section class="py-20 sm:py-24 bg-ice-blue-bg">
	<div class="container mx-auto px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center mb-16">
			<span class="section-label text-navy">Trusted By</span>
			<span class="section-label-bar mx-auto"></span>
			<h2 class="font-serif font-bold text-navy-deep text-2xl sm:text-3xl mt-5 max-w-3xl mx-auto">
				Leading Public Sector, Energy, Telecommunications &amp; Enterprise Organizations
			</h2>
		</div>

		<div class="flex flex-wrap justify-center gap-4">
			{clients.map((client) => (
				<div class="bg-white rounded-lg border-t-4 border-cloud-blue border border-ice-blue-border p-5 w-full sm:w-[calc(50%-0.5rem)] lg:w-[220px]">
					<div class="flex items-center gap-3 mb-2">
						<div class="w-10 h-10 rounded-full bg-ice-blue-bg flex items-center justify-center flex-shrink-0">
							<span class="text-cloud-blue font-bold text-[11px]">{client.initials}</span>
						</div>
						<h3 class="font-bold text-navy-deep text-sm leading-snug">{client.name}</h3>
					</div>
					<p class="text-text-muted text-xs">{client.project}</p>
				</div>
			))}
		</div>
	</div>
</section>
