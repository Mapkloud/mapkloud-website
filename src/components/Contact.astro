---
// Contact — CTA section anchored by the Navbar "Contact" and Hero "Get Started Today" links
---

<section id="contact" class="bg-ice-blue-bg py-20 sm:py-24">
	<div class="container mx-auto px-6 lg:px-8 max-w-2xl text-center">
		<span class="section-label text-navy">Get In Touch</span>
		<span class="section-label-bar mx-auto"></span>

		<h2 class="font-serif font-bold text-navy-deep text-3xl sm:text-4xl mt-6 mb-4">
			Let's start your transformation
		</h2>
		<p class="text-text-gray text-base sm:text-lg leading-relaxed mb-10">
			Tell us about your challenge — our team will respond within one business day.
		</p>

		<div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
			<a href="mailto:info@mapkloud.com" class="bg-cloud-blue hover:bg-cloud-blue/90 text-white px-7 py-3 rounded-md text-sm font-semibold transition-colors duration-200 w-full sm:w-auto text-center">
				Email Us
			</a>
			<a href="https://www.linkedin.com/company/mapkloud/about/" class="border border-cloud-blue text-cloud-blue hover:bg-cloud-blue hover:text-white px-7 py-3 rounded-md text-sm font-semibold transition-colors duration-200 w-full sm:w-auto text-center">
				Connect on LinkedIn
			</a>
		</div>

		<a href="mailto:info@mapkloud.com" class="text-text-muted text-sm hover:text-cloud-blue transition-colors duration-200">
			info@mapkloud.com
		</a>
	</div>
</section>
